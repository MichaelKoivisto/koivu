# === OS & System Junk ===
.DS_Store
Thumbs.db
*.swp
*~

# === Common Lisp / Scheme Artifacts ===
*.fasl
*.lib
*.dx64fsl
*.out
.ext/
.quicklisp/

# === Koivu Project Specific Outputs ===
# Ignore compiled binaries from the Stage 1 & Stage 2 bootstrap steps
bootstrap/stage1/koivu-seed
bootstrap/stage1/koivu-seed.exe
bootstrap/stage2/koivu-sapling
bootstrap/stage2/koivu-sapling.exe

# Ignore output assembly, objects, and executables generated during test passes.
# Committed seed assembly is the exception: it is a published artifact, not a
# build by-product. See docs/architecture/08_seed_artifacts.md, section 3.
tests/scratch/
*.s
!bootstrap/**/*.s
*.o
*.elf
*.macho
*.bin

# Ignore heavy Unity Build and temporary scratch artifacts (e.g., Unreal Engine parsing tests)
*.unity.cpp
logs/
*.log
pictures/
*.obj
*.exe
*.lst
*.kate-swp
